# Railway template variables, not local smuf .env syntax.
# Verify that Railway provides raw TCP access to the control port and
# wildcard HTTP routing to this service. These variables do not configure
# public networking by themselves.
SMUF_DOMAIN=${RAILWAY_PUBLIC_DOMAIN}
SMUF_AUTH_TOKEN=${{secret(64, "abcdef0123456789")}}

# Optional server settings:
# SMUF_CONTROL_PORT=7000
# SMUF_HTTP_PORT=8080
# SMUF_MAX_CONNS_PER_IP=5
# SMUF_CONN_RATE_PER_MIN=30
# SMUF_TCP_PORT_RANGE=20000-20100
# Raw TCP also requires public routes for every allocated port.
#
# Do not copy Railway ${...} expressions into a local .env file. smuf treats
# them as literal text and does not perform variable expansion.
