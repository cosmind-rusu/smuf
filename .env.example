# ==========================================
# smuf-server — Railway template variables
# ==========================================
# These are configured through Railway dashboard.
#
# Required:
SMUF_DOMAIN=${RAILWAY_PUBLIC_DOMAIN}

# Recommended (auto-generated on deploy via template):
SMUF_AUTH_TOKEN=${{secret(64, "abcdef0123456789")}}

# Optional:
# SMUF_HTTP_PORT=8080
# SMUF_MAX_CONNS_PER_IP=10
# SMUF_TCP_PORT_RANGE=20000-30000
